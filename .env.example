# Origin used for canonical URLs and authentication emails.
# Override with your local origin only when intentionally testing local email callbacks.
NEXT_PUBLIC_SITE_URL=https://merryland-sandy.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Keep server-only secrets out of NEXT_PUBLIC variables.
# Required for secure server-side payment confirmation. Never expose this key publicly.
# SUPABASE_SERVICE_ROLE_KEY=
# Start in test mode; use an rzp_test_ key ID.
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
